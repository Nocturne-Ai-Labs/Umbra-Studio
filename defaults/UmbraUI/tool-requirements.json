        "LTXVConcatAVLatent",
        "QwenImage21Cache",
        "TextEncodeQwenImage21",
        "SaveImageAdvanced"
      ],
      "customNodes": [],
      "notes": "Optional built-in nodes; LTX 2.3 and Qwen 2.1 weights remain separate model selections. No Turbo LoRA is downloaded."
    },
    {
      "id": "frameforge-world",
      "label": "Frame Forge — optional WorldMirror 3D nodes",
      "optional": true,
      "optIn": true,
      "workflowIds": [
        "frameforge-world"
      ],
      "minimumComfyVersion": "0.38.0",
      "modelProfiles": [],
      "requiredBuiltinClasses": [],
      "customNodes": [
        {
          "name": "ComfyUI_HYWorld2",
          "minimumCommit": "a80b011c5a1af0e0f358659c7446822d43cb7d05",
          "requiredClasses": [
            "VNCCS_LoadWorldMirrorV2Model",
            "VNCCS_WorldMirrorV2_3D",
            "VNCCS_SavePLY",
            "VNCCS_BackgroundPreview"
          ]
        }
      ],
      "notes": "Heavy optional 3D installation. Requires a compatible NVIDIA CUDA toolchain and native gsplat/recast/PyTorch3D builds. Setup runs the upstream native builder and reports failures. WorldMirror model downloads are controlled by the upstream nodes."
    },
    {
      "id": "longshot-studio",
      "label": "Longshot Studio (optional) — r34vtraining",
      "optional": true,
      "optIn": true,
      "workflowIds": [
        "longshot-studio"
      ],
      "minimumComfyVersion": "0.38.0",
      "modelProfiles": [],
