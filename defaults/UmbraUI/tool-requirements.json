{
  "schemaVersion": 1,
  "features": [
    {
      "id": "frameforge-video",
      "label": "Frame Forge — H3 video nodes",
      "optional": true,
      "optIn": true,
      "workflowIds": [
        "frameforge-video"
      ],
      "minimumComfyVersion": "0.38.0",
      "modelProfiles": [],
      "requiredBuiltinClasses": [
        "MiniMaxH3ReferenceToVideo",
        "UNETLoader",
        "CLIPLoader",
        "VAELoader",
        "VAEDecode",
        "VAEDecodeAudio",
        "CreateVideo",
        "SaveVideo",
        "SamplerCustomAdvanced"
      ],
      "customNodes": [
        {
          "name": "ComfyUI-H3-Motion-Context",
          "minimumCommit": "5335715abe54c1a9bfbe3494da29aae3e8635ce3",
          "requiredClasses": [
            "MiniMaxH3MotionContext",
            "MiniMaxH3MotionContextTrim",
            "MiniMaxH3MotionContextLoadLatent",
            "MiniMaxH3MotionContextSaveLatent"
          ]
        }
      ],
      "notes": "Optional companion nodes for Frame Forge timeline generation. Install the Frame Forge application separately above. H3 weights, encoders and VAEs are separate model selections. Restart ComfyUI after installing."
    },
    {
      "id": "frameforge-extras",
